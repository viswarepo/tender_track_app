{
  "realm": "tendertrack",
  "enabled": true,
  "sslRequired": "none",
  "roles": { "realm": [ { "name": "admin" }, { "name": "coordinator" }, { "name": "clinician" } ] },
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [ {
      "providerId": "declarative-user-profile",
      "config": { "kc.user.profile.config": [
        "{\"attributes\":[{\"name\":\"username\"},{\"name\":\"email\"},{\"name\":\"firstName\"},{\"name\":\"lastName\"},{\"name\":\"tenant_id\",\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]}}]}"
      ] }
    } ]
  },
  "clients": [ {
    "clientId": "tendertrack-web",
    "publicClient": true,
    "directAccessGrantsEnabled": true,
    "standardFlowEnabled": true,
    "redirectUris": ["http://localhost:*"],
    "webOrigins": ["+"],
    "protocolMappers": [
      { "name": "tenant_id", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-attribute-mapper",
        "config": { "user.attribute": "tenant_id", "claim.name": "tenant_id", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "true" } },
      { "name": "realm-roles", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-realm-role-mapper",
        "config": { "claim.name": "realm_access.roles", "multivalued": "true", "jsonType.label": "String", "access.token.claim": "true" } }
    ]
  } ],
  "users": [
    { "username": "viswa", "enabled": true, "emailVerified": true, "email": "viswa@example.com", "firstName": "Viswa", "lastName": "Ram",
      "attributes": { "tenant_id": ["11111111-1111-1111-1111-111111111111"] },
      "credentials": [ { "type": "password", "value": "tender", "temporary": false } ],
      "realmRoles": ["admin"] }
    ,
    { "username": "marcus", "enabled": true, "emailVerified": true, "email": "marcus@example.com", "firstName": "Marcus", "lastName": "Hale",
      "attributes": { "tenant_id": ["11111111-1111-1111-1111-111111111111"] },
      "credentials": [ { "type": "password", "value": "tender", "temporary": false } ],
      "realmRoles": ["coordinator"] }
    ,
    { "username": "okafor", "enabled": true, "emailVerified": true, "email": "okafor@example.com", "firstName": "Anika", "lastName": "Okafor",
      "attributes": { "tenant_id": ["11111111-1111-1111-1111-111111111111"] },
      "credentials": [ { "type": "password", "value": "tender", "temporary": false } ],
      "realmRoles": ["clinician"] }
    ,
    { "username": "elena", "enabled": true, "emailVerified": true, "email": "elena@example.com", "firstName": "Elena", "lastName": "Ruiz",
      "attributes": { "tenant_id": ["22222222-2222-2222-2222-222222222222"] },
      "credentials": [ { "type": "password", "value": "tender", "temporary": false } ],
      "realmRoles": ["admin"] }
  ]
}
